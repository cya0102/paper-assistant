# 复制为 .env 并填入真实 Key（不要提交 .env）
# OpenAI
OPENAI_API_KEY=

# DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Xiaomi MiMo（可选）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 可选：指定 OpenAI 聊天模型
OPENAI_CHAT_MODEL=gpt-4o-mini

# Phase 3 Agent / Redis
PAPER_AGENT_LLM_PROVIDER=openai
PAPER_AGENT_LLM_MODEL=gpt-4o-mini
PAPER_AGENT_REDIS_URL=redis://localhost:6379/0

# 默认保持无 Key、离线可运行；切换 openai 后需要 OPENAI_API_KEY 并重新索引
PAPER_AGENT_EMBEDDING_PROVIDER=hashing
PAPER_AGENT_EMBEDDING_MODEL=text-embedding-3-small

# lexical 无需下载；cross-encoder 需要 uv sync --extra neural
PAPER_AGENT_RERANKER_PROVIDER=lexical
PAPER_AGENT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Paper Agent PostgreSQL
PAPER_AGENT_DATABASE_URL=postgresql+psycopg://paper_agent:paper_agent@localhost:5432/paper_agent
